# =============================================================================
# Smart Bus Transit — Environment Variables
#
# Copy this file to `.env` at the REPO ROOT only. All three apps share one
# Supabase project, so each app's vite.config.ts sets `envDir: "../../"` to
# read this single root .env instead of needing three separate copies that
# could drift out of sync.
#
# Vite only exposes variables prefixed with VITE_ to client bundles.
# NEVER put the service-role key or any signing secret in a VITE_ variable.
# =============================================================================

# --- Frontend-safe (all three apps) -----------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: MapTiler/other raster tile key. The app works with the free
# OpenStreetMap tile server out of the box (no key required); set this only
# if you want a different tile provider.
VITE_MAPTILER_KEY=

# --- Admin app only (still frontend-safe) -----------------------------------
VITE_ADMIN_SUPPORT_EMAIL=admin@transit.gov

# --- Passenger app only ------------------------------------------------------
# Transport authority UPI id used by the MOCK payment provider UI only.
# The AUTHORITATIVE UPI/fare validation happens server-side inside the
# create_secure_ticket() RPC (see supabase/migrations), which reads the
# configured UPI id from the `transport_authority_config` table — this
# client value is display-only and never trusted.
VITE_MOCK_UPI_ID=transit-authority@upi

# =============================================================================
# SERVER-ONLY — set these in the Supabase Dashboard (Project Settings > API,
# and Edge Functions > Secrets). Do NOT put them in any apps/* .env file and
# do NOT prefix them with VITE_.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=   (Dashboard only; used by CI/seed scripts, never shipped to a browser)
# TICKET_QR_SIGNING_SECRET=    (Edge Function / Vault secret used by create_secure_ticket RPC via pgsodium)

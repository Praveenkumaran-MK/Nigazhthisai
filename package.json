{
  "name": "smart-bus-transit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:passenger": "turbo run dev --filter=@sbt/passenger",
    "dev:conductor": "turbo run dev --filter=@sbt/conductor",
    "dev:admin": "turbo run dev --filter=@sbt/admin",
    "build": "turbo run build",
    "build:passenger": "turbo run build --filter=@sbt/passenger",
    "build:conductor": "turbo run build --filter=@sbt/conductor",
    "build:admin": "turbo run build --filter=@sbt/admin",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
